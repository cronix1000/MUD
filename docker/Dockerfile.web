# syntax=docker/dockerfile:1.4
ARG APP=mudclient

# --- Stage 1: Dependencies ---
FROM node:22-alpine AS deps
WORKDIR /repo

RUN apk add --no-cache libc6-compat python3 make g++

COPY package.json package-lock.json ./
COPY MudAdmin/package.json    MudAdmin/package.json
COPY MudClient/package.json   MudClient/package.json
COPY mud-ws-gateway/package.json mud-ws-gateway/package.json

RUN npm ci

# --- Stage 2: Build ---
FROM node:22-alpine AS build
ARG APP=mudclient
ARG WS_URL="<lan-host>:18080/ws"
WORKDIR /repo

COPY --from=deps /repo /repo

COPY MudAdmin/  MudAdmin/
COPY MudClient/ MudClient/

# Stamp the WS URL into MudClient's nuxt.config.ts before building it.
RUN if [ "$(echo "$APP" | tr '[:upper:]' '[:lower:]')" = "mudclient" ]; then \
      cp MudClient/nuxt.config.ts MudClient/nuxt.config.ts.orig && \
      node -e "\
        const fs=require('fs'); \
        const p='MudClient/nuxt.config.ts'; \
        let s=fs.readFileSync(p,'utf8'); \
        s=s.replace(/mudWsUrl:\s*['\"][^'\"]*['\"]/, \"mudWsUrl: 'ws://${WS_URL}'\"); \
        fs.writeFileSync(p,s);"; \
    fi

# Build the target app into a known location: /repo/app-output.
# Only one workspace builds per image, so we name the output dir ourselves
# instead of relying on the per-workspace .output path.
RUN if [ "$(echo "$APP" | tr '[:upper:]' '[:lower:]')" = "mudclient" ]; then \
      npm --workspace mudclient run build && \
      cp -a /repo/mudclient/.output /repo/app-output; \
    else \
      npm --workspace MudAdmin run build && \
      cp -a /repo/MudAdmin/.output  /repo/app-output; \
    fi

# --- Stage 3: Runtime ---
FROM node:22-alpine AS runtime
WORKDIR /srv/app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 web

COPY --from=build --chown=web:nodejs /repo/app-output /srv/app

USER web

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    NUXT_HOST=0.0.0.0 \
    NUXT_PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null 2>&1 || exit 1

CMD ["node", "/srv/app/server/index.mjs"]
