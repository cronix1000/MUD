# syntax=docker/dockerfile:1.4
ARG APP=mudclient

# --- Stage 1: Dependencies ---
FROM node:22-alpine AS deps
WORKDIR /repo

RUN apk add --no-cache libc6-compat python3 make g++

COPY package.json package-lock.json ./
COPY MudAdmin/package.json MudAdmin/package.json
COPY MudClient/package.json MudClient/package.json
COPY mud-ws-gateway/package.json mud-ws-gateway/package.json

RUN npm ci

# --- Stage 2: Build ---
FROM node:22-alpine AS build
ARG APP=mudclient
ARG WS_URL="<lan-host>:18080/ws"
WORKDIR /repo

COPY --from=deps /repo /repo

# 1. Copy source files FIRST
COPY MudAdmin/ MudAdmin/
COPY MudClient/ MudClient/

# 2. Backup and patch nuxt.config.ts for MudClient
RUN case "$APP" in \
      mudclient|mudClient|MudClient) \
        cp MudClient/nuxt.config.ts MudClient/nuxt.config.ts.orig ; \
        node -e "\
          const fs = require('fs'); \
          const p = 'MudClient/nuxt.config.ts'; \
          let s = fs.readFileSync(p, 'utf8'); \
          s = s.replace(/mudWsUrl:\s*['\"][^'\"]*['\"]/, \"mudWsUrl: 'ws://${WS_URL}'\"); \
          fs.writeFileSync(p, s);" ;; \
    esac

# 3. Build target application
RUN case "$APP" in \
      mudclient|mudClient|MudClient) \
        npm --workspace mudclient run build ;; \
      *) \
        npm --workspace MudAdmin run build ;; \
    esac

# --- Stage 3: Runtime ---
FROM node:22-alpine AS runtime
ARG APP=mudclient
WORKDIR /srv/app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 web

# Stage both apps' .output dirs into named tmp paths and pick the right one.
# Globbing (/repo/*/.output) raced cached layers from the other workspace.
COPY --from=build --chown=web:nodejs /repo/mudclient/.output /tmp/mc.output
COPY --from=build --chown=web:nodejs /repo/MudAdmin/.output  /tmp/admin.output
RUN case "$APP" in \
      mudclient|mudClient|MudClient) cp -a /tmp/mc.output/. /srv/app/ ;; \
      *)                              cp -a /tmp/admin.output/. /srv/app/ ;; \
    esac

USER web

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    NUXT_HOST=0.0.0.0 \
    NUXT_PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null 2>&1 || exit 1

CMD ["node", "/srv/app/server/index.mjs"]
