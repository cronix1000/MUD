# docker-compose env file. Copy to `.env` on each host and adjust.
# DO NOT commit the populated .env files; add them to .gitignore.

# ----- Image registry / tag -----
REGISTRY=ghcr.io
REPO_OWNER=cronix1000
TAG=latest

# ----- Hostnames -----
PROD_DOMAIN=mud.example.com
BETA_DOMAIN=beta.mud.example.com

# ----- WS URL exposed to the client UI -----
WS_URL=wss://mud.example.com/ws
# beta build-arg: host:port/path that the client UI connects to. When the
# beta instance is reached via Caddy on :18080, set this to 10.0.0.223:18080/ws
# so the URL becomes ws://10.0.0.223:18080/ws after the Dockerfile prefixes ws:.
BETA_WS_URL=10.0.0.223:18080/ws

# ----- Logging -----
LOG_LEVEL=info
IDLE_TIMEOUT_S=1800
TZ=UTC

# ----- prod ports (host side) -----
HTTP_PORT=80
HTTPS_PORT=443
GATEWAY_PORT=8443
ADMIN_PORT=3000
CLIENT_PORT=3001

# ----- beta ports (host side) -----
BETA_HTTP_PORT=8080
BETA_HTTPS_PORT=8443
BETA_GATEWAY_PORT=9443
BETA_ADMIN_PORT=3010
BETA_CLIENT_PORT=3011
