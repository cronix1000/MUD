# docker-compose env file. Copy to `.env` on the prod host and adjust.
# DO NOT commit the populated .env files; add them to .gitignore.

# ----- Image registry / tag -----
REGISTRY=ghcr.io
REPO_OWNER=cronix1000
TAG=prod

# ----- Hostnames -----
PROD_DOMAIN=tower-mud.unlrealities.ca
PROD_ADMIN_DOMAIN=tower-admin.unlrealities.ca

# ----- WS URL exposed to the client UI -----
WS_URL=wss://tower-mud.unlrealities.ca/ws

# ----- Logging -----
LOG_LEVEL=info
IDLE_TIMEOUT_S=1800
TZ=UTC

# ----- Host ports (Caddy + Gateway only; web containers are internal) -----
HTTP_PORT=80
HTTPS_PORT=443
GATEWAY_PORT=8443

# ----- Postgres connection string -----
# Consumed by mud-server and mud-admin. The search_path is set at the role
# level by docker/postgresql/init/00-bootstrap.sh so URLs no longer need the
# `?options=-c search_path=...` segment.
#
# On the VPS the Postgres container is reached via the docker network alias
# 'mud-postgres' (set up in scripts/postgres-connection.md).
MUD_DATABASE_URL=postgresql://mud_prod:<password>@mud-postgres:5432/mud_prod
