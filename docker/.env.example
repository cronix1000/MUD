# docker-compose env file. Copy to `.env` on each host and adjust.
# DO NOT commit the populated .env files; add them to .gitignore.

# ----- Image registry / tag -----
REGISTRY=ghcr.io
REPO_OWNER=cronix1000
TAG=latest

# ----- Hostnames -----
PROD_DOMAIN=tower-mud.unlrealities.ca
BETA_DOMAIN=beta-tower-mud.unlrealities.ca

# ----- WS URL exposed to the client UI -----
WS_URL=wss://tower-mud.unlrealities.ca/ws
# beta build-arg: host:port/path that the client UI connects to. When the
# beta instance is reached via Caddy on :18080, set this to <lan-host>:18080/ws
# so the URL becomes ws://<lan-host>:18080/ws after the Dockerfile prefixes ws:.
BETA_WS_URL=beta-tower-mud.unlrealities.ca/ws

# ----- Logging -----
LOG_LEVEL=info
IDLE_TIMEOUT_S=1800
TZ=UTC

# ----- prod ports (host side) -----
HTTP_PORT=80
HTTPS_PORT=443
GATEWAY_PORT=8443
ADMIN_PORT=3000
CLIENT_PORT=3001

# ----- beta ports (host side) -----
# Must not collide with the prod ports above. Both profiles run on the same
# VPS, so pick high ports here.
BETA_HTTP_PORT=18080
BETA_HTTPS_PORT=18443
BETA_GATEWAY_PORT=19443
BETA_ADMIN_PORT=3010
BETA_CLIENT_PORT=3011

# ----- Postgres connection strings -----
# Consumed by mud-server and mud-admin in both profiles. The search_path
# is set at the role level by docker/postgresql/init/00-bootstrap.sh so
# URLs no longer need the `?options=-c search_path=...` segment. Older
# URLs that include it still work (the URL options win over the role
# default).
#
# On the VPS the Postgres container is reached via the docker network
# alias 'mud-postgres' (set up in scripts/postgres-connection.md). The
# password is whatever was generated during the init bootstrap.
MUD_DATABASE_URL_PROD=postgresql://mud_prod:<password>@mud-postgres:5432/mud_prod
MUD_DATABASE_URL_BETA=postgresql://mud_beta:<password>@mud-postgres:5432/mud_beta
