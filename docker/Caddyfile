{
    # Admin API — needed so Caddy picks up runtime config changes
    admin localhost:2019
}

# ----- prod -----
https://tower-mud.unlrealities.ca {
    encode zstd gzip

    handle /ws* {
        reverse_proxy mud-gateway:8443 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
        }
    }

    handle_path /admin* {
        reverse_proxy mud-admin:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle {
        reverse_proxy mud-client:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
}

