:80 {
    encode zstd gzip

    # WebSocket Gateway
    handle /ws* {
        reverse_proxy mud-gateway-beta:8443 {
            header_up Host {host}
        }
    }

    # Admin Panel
    handle_path /admin* {
        reverse_proxy mud-admin-beta:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Default: Mud Game Client
    handle {
        reverse_proxy mud-client-beta:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}