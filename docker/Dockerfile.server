# syntax=docker/dockerfile:1.6
# Server Dockerfile. Build from the repo root.
# Produces a slim runtime image with the C++ server, scripts, regions,
# and the world DB shell. State lives in a Postgres database reached via
# the MUD_DATABASE_URL environment variable; no DB files in the image.

ARG UBUNTU_VERSION=22.04
FROM ubuntu:${UBUNTU_VERSION} AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && for i in 1 2 3; do \
      apt-get install -y --no-install-recommends --fix-missing \
          build-essential \
          ca-certificates \
          cmake \
          git \
          liblua5.3-dev \
          libpqxx-dev \
          nlohmann-json3-dev \
      && break; \
      echo "apt-get install failed (attempt $i), refreshing and retrying..."; \
      sleep 5; \
      apt-get update; \
    done \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Build context is the repo root; copy only the server tree.
COPY ModularMudServer/ /src/

RUN mkdir -p /src/build \
 && cmake -S /src -B /src/build -G "Unix Makefiles" \
       -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
 && bash -c '\
      set +e; \
      cmake --build /src/build --config Release --parallel "$(nproc)" 2> /tmp/build.err; \
      rc=$?; \
      if [ $rc -ne 0 ]; then \
        echo "=== parallel build failed (rc=$rc); re-running single-threaded with -k to surface errors ==="; \
        cmake --build /src/build --config Release -- -j1 -k 2>&1 | tail -400; \
        echo "=== captured stderr tail ==="; \
        tail -400 /tmp/build.err; \
      fi; \
      exit $rc' \
 && ls -lh /src/build/bin/

# ----- runtime image -----
FROM ubuntu:${UBUNTU_VERSION} AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && for i in 1 2 3; do \
      apt-get install -y --no-install-recommends --fix-missing \
          ca-certificates \
          gosu \
          iproute2 \
          libgcc-s1 \
          liblua5.3-0 \
          libpqxx-6.4 \
          libstdc++6 \
          postgresql-client \
          tini \
      && break; \
      echo "apt-get install failed (attempt $i), refreshing and retrying..."; \
      sleep 5; \
      apt-get update; \
    done \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 mud \
 && useradd  --system --uid 1001 --gid mud --create-home --shell /usr/sbin/nologin mud

WORKDIR /mud

COPY --from=builder /src/build/bin/ModularMudServer   /mud/ModularMudServer
COPY --from=builder /src/scripts/                    /mud/scripts/
COPY --from=builder /src/regions/                    /mud/regions/
COPY --from=builder /src/mud.db                      /mud/mud.world.db

COPY docker/entrypoint-server.sh /usr/local/bin/entrypoint-server.sh
RUN chmod +x /usr/local/bin/entrypoint-server.sh \
 && chown -R mud:mud /mud

ENV MUD_DB_PATH=/mud/mud.world.db \
    MUD_PLAYERS_DB=/mud/mud.players.db \
    MUD_DATABASE_URL= \
    PORT=27015

EXPOSE 27015

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=5 \
  CMD ss -tln | grep -q ":${PORT}" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-server.sh"]
