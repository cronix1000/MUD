# docker/postgresql/pg.env.example
#
# Copy to pg.env (sibling of the root .env) and fill in real values.
# pg.env lives on the VPS host only; never commit it.
#
# The compose file in this directory reads POSTGRES_PASSWORD (the cluster
# superuser), plus MUD_PROD_PASSWORD and MUD_BETA_PASSWORD for the two
# per-profile database owners.

POSTGRES_PASSWORD=change-me-postgres-superuser
MUD_PROD_PASSWORD=change-me-mud-prod
MUD_BETA_PASSWORD=change-me-mud-beta
TZ=UTC
