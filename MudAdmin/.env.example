# MudAdmin/.env.example
#
# Copy to `.env` (sibling of this file, NOT committed) and edit values.
# `MudAdmin/.gitignore` ignores `.env` and `.env.*` while keeping
# `.env.example` checked in.
#
# MudAdmin reads `MUD_DATABASE_URL` at server start. The pool's
# `connect` listener (server/utils/db.ts:46-50) issues
# `SET search_path TO world, players, _meta, public` on every new
# physical client, so the URL itself does not need URL options.
#
# --- Local dev (recommended): SSH tunnel into the VPS beta DB ---
#
#   ssh -L 5432:127.0.0.1:5432 ubuntu@<vps-host>
#   MUD_DATABASE_URL=postgresql://mud_beta:<pw>@127.0.0.1:5432/mud_beta
#
# Point at mud_beta, never mud_prod, for development work.
#
# --- Local-only Postgres (offline work) ---
#
# Spin up a sibling container with `docker compose -f
# docker/postgresql/docker-compose.yml up -d postgres` and a `pg.env`
# that defines a `mud_local` role + db, then point the URL at
# 127.0.0.1:5432 and run `node scripts/migrate.mjs` once.
#
# --- On the VPS (within docker-compose) ---
#
# The URL uses the docker network name `postgres` instead of
# 127.0.0.1. See `docker/.env.example` for the prod/beta pair shipped
# with compose, and `MudAdmin/AGENTS.md` for the per-profile layout.

MUD_DATABASE_URL=postgresql://mud_beta:CHANGE_ME@127.0.0.1:5432/mud_beta
