# mud-gateway environment configuration.
# Copy this file to `.env` for local docker-compose use, or feed each
# variable to the container via your runtime.

# Hostname of the MUD server.
# Default: 127.0.0.1 (works out-of-the-box for local testing).
# Docker Compose: override to the MUD service alias (e.g. "modularmudserver").
MUD_HOST=127.0.0.1

# TCP port the MUD server is listening on.
MUD_PORT=27015

# Bind host for the mud-gateway WebSocket server.
WS_HOST=0.0.0.0

# Bind port for the mud-gateway WebSocket server.
WS_PORT=8443

# Log level: debug | info | warning | error
LOG_LEVEL=info

# Idle timeout in seconds. 0 = no timeout.
# Closes the TCP+WS connection after this many seconds of silence in
# either direction.
IDLE_TIMEOUT_S=1800
